// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Idade {
  FILHOTE
  ADULTO
  GRANDE
}

enum Tamanho {
  PEQUENO
  MEDIO
  IDOSO
}

enum Nivel_Energia {
  BAIXO
  MEDIO
  ALTO
}

enum Independencia {
  BAIXO
  MEDIO
  ALTO
}

enum Ambiente {
  INTERIOR
  EXTERIOR
  AMBOS
}

model Orgs {
  id            String   @id @default(uuid())
  nome          String
  email         String   @unique
  password_hash String
  whatsapp      String   @unique
  cep           String   @db.VarChar(10)
  endereco_rua  String
  cidade        String
  estado        String
  created_at    DateTime @default(now())
  pets          Pet[]

  @@map("orgs")
}

model Pet {
  id            String        @id @default(uuid())
  nome          String
  idade         Idade
  tamanho       Tamanho
  nivel_energia Nivel_Energia
  independencia Independencia
  ambiente      Ambiente
  created_at    DateTime      @default(now())
  org           Orgs          @relation(fields: [orgs_id], references: [id])
  orgs_id       String

  @@map("pets")
}
